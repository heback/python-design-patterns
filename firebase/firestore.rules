rules_version = '2';

// 탐구학습 진도 규칙.
//  - 학생: 학교 Google 계정(아래 도메인)으로 로그인해야 하고, 자기 uid가 만든 진도 문서만 쓴다. 교사가 수집을 켠 동안만 쓴다.
//  - 교사: 학교 Google 계정 + config/teachers 허용 목록에 있는 이메일. 학생도 같은 도메인이므로 허용 목록이 비어 있거나 없으면 아무도 교사가 아니다(닫힘).
//    도메인을 바꾸면 functions/config.js도 함께 바꾼다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 학교 Google 계정(학생·교사 공통): 구글 로그인 + 확인된 이메일 + 학교 도메인.
    function isSchoolAccount() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('.+@ts[.]hs[.]kr');
    }
    // 교사 = 학교 계정 + 허용 목록(config/teachers.emails)에 있는 이메일. 목록이 없거나 비어 있으면 아무도 교사가 아니다.
    function isTeacher() {
      return isSchoolAccount()
        && exists(/databases/$(database)/documents/config/teachers)
        && get(/databases/$(database)/documents/config/teachers).data.get('emails', []).size() > 0
        && request.auth.token.email in get(/databases/$(database)/documents/config/teachers).data.emails;
    }

    // 제출 설정. 문서가 없으면 닫힘.
    function settings() { return get(/databases/$(database)/documents/config/submission).data; }
    function hasSettings() { return exists(/databases/$(database)/documents/config/submission); }
    function inWindow(s) {
      return (!('opensAt' in s) || request.time >= s.opensAt)
          && (!('closesAt' in s) || request.time < s.closesAt);
    }
    function anyOpen() { return hasSettings() && settings().open == true && inWindow(settings()); }
    function weekOpen(w) {
      return anyOpen() && settings().weeks.get(w, false) == true;
    }
    function codeOk(d) {
      return !exists(/databases/$(database)/documents/config/submissionSecret)
        || get(/databases/$(database)/documents/config/submissionSecret).data.get('code', '') == ''
        || ('code' in d && d.code == get(/databases/$(database)/documents/config/submissionSecret).data.code);
    }

    function isOwner(sid) {
      return request.auth != null
        && get(/databases/$(database)/documents/submissions/$(sid)).data.uid == request.auth.uid;
    }

    // 개인정보 수집·이용 동의. 학생이 동의해야(consents/{uid}가 현재 버전으로 있어야) 진도를 서버에 쓰고 AI 도우미를 쓸 수 있다.
    // 동의 문구를 바꾸면 이 버전과 functions/config.js 의 CONSENT_VERSION, templates/student-auth.js 의 Consent.VERSION 을 함께 올린다
    // (올리면 학생은 새 문구를 보고 다시 동의해야 한다). 세 값이 같은지는 functions 의 테스트가 확인한다.
    function consentVersion() { return '2026-11-06'; }
    function hasConsent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/consents/$(request.auth.uid))
        && get(/databases/$(database)/documents/consents/$(request.auth.uid)).data.get('version', '') == consentVersion();
    }
    // 동의 문서의 모양: 동의 일시는 서버 시각(request.time)이어야 하고(학생이 시각을 꾸밀 수 없다), 이메일은 로그인 계정과 같아야 한다.
    function consentOk(d) {
      return d.keys().hasOnly(['uid', 'student', 'version', 'ai', 'agreedAt'])
        && d.keys().hasAll(['uid', 'student', 'version', 'ai', 'agreedAt'])
        && d.uid == request.auth.uid
        && d.version == consentVersion()
        && d.ai is bool
        && d.agreedAt == request.time
        && d.student is map && d.student.keys().hasOnly(['name', 'email'])
        && d.student.email == request.auth.token.email.lower()
        && d.student.name is string && d.student.name.size() <= 80;
    }

    // 진도 수집 스위치. 꺼져 있거나 문서가 없으면 학생은 진도를 쓸 수 없다(제출 설정과는 별개).
    function monitorOn() {
      return exists(/databases/$(database)/documents/config/monitor)
        && get(/databases/$(database)/documents/config/monitor).data.get('on', false) == true;
    }
    function progressOk(d) {
      return d.keys().hasOnly(['student', 'uid', 'weeks', 'chapters', 'where', 'view', 'viewAt', 'leaves', 'awayMs', 'activeMs', 'lastActiveAt', 'updatedAt'])
        && (!('weeks' in d) || d.weeks is map)           // 학습지 진도(주차별 완료 문항)
        && (!('chapters' in d) || d.chapters is map)     // 교재 읽기 진도(장별 읽은 절)
        && (!('where' in d) || (d.where is string && d.where.size() <= 80))
        // 이 화면을 보고 있는지: on(보이고 포커스 있음)·hidden(탭 가림)·blur(포커스 잃음), 그 상태가 된 시각, 벗어난 횟수·시간(ms)
        && (!('view' in d) || d.view in ['on', 'hidden', 'blur'])
        && (!('viewAt' in d) || d.viewAt is timestamp)
        && (!('leaves' in d) || (d.leaves is number && d.leaves >= 0))
        && (!('awayMs' in d) || (d.awayMs is number && d.awayMs >= 0))
        && d.activeMs is number && d.student is map
        && request.resource.size() < 60000;
    }

    // 설정: 누구나 읽기(비밀 없음), 교사만 쓰기. 제출 코드·교사 목록은 교사만.
    match /config/submission { allow read: if true; allow write: if isTeacher(); }
    // 진도 수집 스위치: 모두 읽고, 쓰기는 함수(setMonitor)만 한다. 교사도 직접 쓰지 못하므로 켜고 끈 시각·이력(monitorEvents)을 조작할 수 없다.
    match /config/monitor { allow read: if true; allow write: if false; }
    match /monitorEvents/{id} { allow read: if isTeacher(); }
    // 개인정보 동의 기록: 학생은 본인 것만 읽고(동의 여부 확인) 처음 한 번 만든다. 한번 동의하면 학생은 고치거나 지울 수 없다(철회·초기화는 교사만 delete).
    // 단, (1) 문구 버전이 올라가 옛 버전이 된 기록은 새 문구에 다시 동의하며 덮어쓸 수 있고, (2) 선택 항목(ai)에 동의하지 않았던 학생은 나중에 동의(false → true)로만 바꿀 수 있다(update). 동의 철회(true → false)는 교사만(delete).
    match /consents/{uid} {
      allow get: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid);
      allow list: if isTeacher();
      allow create: if isSchoolAccount() && uid == request.auth.uid && consentOk(request.resource.data);
      allow update: if isSchoolAccount() && uid == request.auth.uid && consentOk(request.resource.data)
                    && (resource.data.get('version', '') != consentVersion()
                        || (resource.data.get('ai', false) == false && request.resource.data.ai == true));
      allow delete: if isTeacher();
    }
    match /config/assistant { allow read: if true; allow write: if isTeacher(); }      // 학생 AI 도우미 켜기/끄기

    // AI 도우미 대화 기록·토큰 집계: 함수(관리자 권한)만 쓰고 교사만 읽는다. 학생은 읽지도 쓰지도 못한다(한도·집계를 속일 수 없다).
    // 학생은 기록을 지우거나 고칠 수 없다(create·update·delete 모두 막힘). 삭제는 교사만.
    match /chatLogs/{id} { allow read, delete: if isTeacher(); }
    match /chatUsage/{uid} { allow read: if isTeacher(); }
    // 학생별·장별 질문 한도 가감(chatQuota/{uid}): 함수(setAssistantQuota)만 쓰고 교사만 읽는다. 학생이 자기 한도를 올릴 수 없다.
    match /chatQuota/{uid} { allow read: if isTeacher(); }
    // 선생님께 질문(askThreads): 학생 한 명당 대화 하나. 학생은 본인 대화만 읽고, 교사는 모두 읽고 지운다. 쓰기는 함수(askTeacher·replyToStudent·markAskRead)만 한다
    // — 학생이 남의 대화를 읽거나, 답변을 위조하거나, 안 읽음 수·시각을 꾸밀 수 없다. 질문 개수 제한은 없다(함수가 1분에 10번까지만 받는다).
    match /askThreads/{uid} {
      allow get: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid);
      allow list, delete: if isTeacher();
      match /msgs/{id} {
        allow read: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid);
        allow delete: if isTeacher();
      }
    }
    match /stats/{id} { allow read: if isTeacher(); }
    match /config/submissionSecret { allow read, write: if isTeacher(); }
    match /config/teachers { allow read, write: if isTeacher(); }

    // 진도(완료 문항 수·읽은 절, 활동 시간, 마지막 활동 시각). 응답 본문은 담지 않는다.
    // 문서 ID 는 로그인한 학생의 uid 와 같아야 한다(학생 한 명에 문서 하나, 남의 문서를 선점할 수 없다). 학생은 본인 문서만 읽고 쓴다.
    match /progress/{sid} {
      allow get, list, delete: if isTeacher();
      allow get: if isSchoolAccount() && sid == request.auth.uid;        // 학생은 본인 문서 한 건만 읽는다(체류 시간이 줄어들지 않게 서버의 내 값과 비교하려고). 목록·남의 문서는 불가
      allow create: if isSchoolAccount() && sid == request.auth.uid && request.resource.data.uid == request.auth.uid
                    && hasConsent() && monitorOn() && progressOk(request.resource.data);
      allow update: if isTeacher()
                    || (isSchoolAccount() && sid == request.auth.uid && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && hasConsent() && monitorOn() && progressOk(request.resource.data));
    }

    // 돌발 퀴즈(패턴별 서술형). config/quiz = 가장 최근 퀴즈의 학생용 정보(문항 글·마감 시각·상태, 채점 기준 없음): 누구나 읽고 쓰기는 함수만.
    // quizSessions(기록·답안·채점 초안)는 교사만 읽고, 학생은 자기 답안 문서만 읽는다. 학생에게 보낸 결과 quizResults/{sid}__{uid}는 본인(uid 필드)과 교사만 읽는다. 모든 쓰기는 함수(startQuiz·submitQuiz·gradeQuizAnswer·saveQuizGrade·releaseQuiz)만 한다.
    match /config/quiz { allow read: if true; allow write: if false; }
    match /quizSessions/{sid} {
      allow read, delete: if isTeacher();
      match /answers/{uid} { allow get: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid); allow list, delete: if isTeacher(); }
      match /grades/{uid} { allow read, delete: if isTeacher(); }
    }
    match /quizResults/{rid} {
      allow get, list: if isTeacher() || (isSchoolAccount() && resource.data.uid == request.auth.uid);
      allow delete: if isTeacher();
    }

    // 교재 코드 편집기에서 학생이 주석을 달거나 고친 코드(codeNotes). 학생 한 명당 codeNotes/{uid}(이름·이메일·마지막 저장 시각)와
    // 그 아래 blocks/{블록 id}(코드 블록 하나: 쪽·번호·제목·원본 코드의 해시·학생이 고친 코드·추가한 줄). 학생은 본인 것만 읽고 쓰고 지울 수 있다(처음 코드로 되돌리면 지운다).
    // 교사는 모두 읽는다. 동의(현재 문구)가 있어야 쓸 수 있고, 저장 시각은 서버 시각이어야 한다.
    function codeHeadOk(d, uid) {
      return d.keys().hasOnly(['uid', 'student', 'updatedAt']) && d.keys().hasAll(['uid', 'student', 'updatedAt'])
        && d.uid == uid && d.updatedAt == request.time
        && d.student is map && d.student.keys().hasOnly(['name', 'email']) && d.student.email == request.auth.token.email.lower();
    }
    function codeBlockOk(d) {
      return d.keys().hasOnly(['page', 'kind', 'idx', 'title', 'h', 'code', 'added', 'addedN', 'updatedAt'])
        && d.keys().hasAll(['page', 'kind', 'idx', 'title', 'h', 'code', 'added', 'addedN', 'updatedAt'])
        && d.page is string && d.page.size() <= 60 && d.kind in ['code', 'exercise'] && d.idx is int && d.idx >= 0 && d.idx < 1000
        && d.title is string && d.title.size() <= 200 && d.h is string && d.h.size() <= 20
        && d.code is string && d.code.size() <= 30000 && d.added is string && d.added.size() <= 6000
        && d.addedN is int && d.addedN >= 0 && d.updatedAt == request.time;
    }
    match /codeNotes/{uid} {
      allow get: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid);
      allow list, delete: if isTeacher();
      allow create, update: if isSchoolAccount() && uid == request.auth.uid && hasConsent() && codeHeadOk(request.resource.data, uid);
      match /blocks/{bid} {
        allow read: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid);
        allow create, update: if isSchoolAccount() && uid == request.auth.uid && hasConsent() && bid.matches('[A-Za-z0-9_-]{1,100}') && codeBlockOk(request.resource.data);
        allow delete: if isTeacher() || (isSchoolAccount() && uid == request.auth.uid);
      }
    }

    match /submissions/{sid} {
      allow get: if isTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, delete: if isTeacher();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && anyOpen() && codeOk(request.resource.data)
                    && request.resource.data.keys().hasOnly(['student', 'uid', 'code', 'updatedAt']);
      allow update: if (isTeacher())
                    || (request.auth != null && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && anyOpen() && codeOk(request.resource.data)
                        && request.resource.data.keys().hasOnly(['student', 'uid', 'code', 'updatedAt']));

      // 주차별 응답: 열린 주차에만 본인이 쓴다.
      match /weeks/{w} {
        allow read: if isTeacher() || (request.auth != null && isOwner(sid));
        allow create, update: if request.auth != null && isOwner(sid)
                              && w in ['1', '2', '3', '4', '5'] && weekOpen(w)
                              && codeOk(request.resource.data)
                              && request.resource.data.keys().hasOnly(['json', 'code', 'updatedAt'])
                              && request.resource.data.json is string
                              && request.resource.size() < 400000;
        allow delete: if isTeacher();
      }

      // AI 초안: 교사만.
      match /drafts/{k} { allow read, write: if isTeacher(); }

      // 공개 피드백: 교사가 쓰고 소유 학생이 읽는다.
      match /published/{k} {
        allow read: if isTeacher() || (request.auth != null && isOwner(sid));
        allow write: if isTeacher();
      }
    }
  }
}
